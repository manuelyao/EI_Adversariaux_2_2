def jeu_associe(IOSM, L):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t[0]=='!':
                a=t[1:]
                if a in L and s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puit'))
    Vb=[i for i in range(len(IOSM)) if i not in Vr]+['puit']
    n=len(Vr+Vb)-1
    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                else:
                    Vb.append(n)
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    Vr.append(n)
    e.append((n,'tau','puit'))
    e.append(('puit','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,i,j,Vr,Vb,e):
    W = [[[]]*(j+1)]*(i+2)
    kj = 0
    for j_prime in range(j+1):
        i_prime=0
        while (i_prime<=i):
            W[i_prime+1][j_prime]=W[i_prime][j_prime]
            for p in Vb:
                if not p in W[i_prime][j_prime]:
                    for q in W[i_prime][j_prime]:
                        if (p,_,q) in e:
                            W[i_prime+1][j_prime].append(p)
                            break
            for p in Vr:
                if not p in W[i_prime][j_prime]:
                    for q in Vb:
                        if (p,_,q) in e and q in W[i_prime][j_prime]:
                            W[i_prime+1][j_prime].append(p)
                            break
            i_prime += 1
        
        for i in range(i+1):
            if W[i][j_prime]==W[i+1][j_prime]:
                kj=i
                break

        if j_prime < j:
            W[0][j_prime+1]=W[kj][j_prime]
            for p in Vr:
                for q in Vb:
                    for r in Vb:
                        if ((p,_,q) in e and (p,_,r) in e
                            and q in W[kj][j_prime] and not r in W[kj][j_prime]
                            and p not in W[0][j_prime+1]):
                            W[0][j_prime+1].append(p)
                            break
    
    return W[i][j]
        

                
                

