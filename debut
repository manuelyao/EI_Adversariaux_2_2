def jeu_associe(IOSM):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t.startswith('!'):
                if s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puit'))

    Vb=[i for i in range(len(IOSM)) if i not in Vr]
    n=len(IOSM)

    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                    e.append((n, 'tau', 'puit'))
                else:
                    Vb.append(n)
                
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    
    Vr.append(n)
    if 'puit' not in Vb: 
        Vb.append('puit')
    e.append((n,'tau','puit'))
    e.append(('puit','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,Vr,Vb,e):
    """state, point list, point list, 3-uple list -> set list list
    Returns the W strategy matrix representing the best strategies
    when it comes to reaching t. Also allows for the calculation of
    the rank of a point."""
    
    all_nodes = Vr + Vb + ['puit']
    succs = {node: [] for node in all_nodes}
    for u, _, v in e:
        if u in succs: 
            succs[u].append(v)
    
    W = []
    current_set = {t, 'puit'}
    W.append([current_set])
    
    j = 0
    while True:
        while True:
            last_set = W[j][-1]
            new_set = last_set.copy()

            for p in Vb:
                if p not in new_set:
                    if any(q in last_set for q in succs.get(p, [])):
                        new_set.add(p)
            
            for p in Vr:
                if p not in new_set:
                    children = succs.get(p, [])
                    if children and all(q in last_set for q in children):
                        new_set.add(p)
            
            if len(new_set) == len(last_set):
                break 
            
            W[j].append(new_set)
            
        stable_set = W[j][-1]
        next_j_start_set = stable_set.copy()
        added_vertical = False
        
        for p in Vr:
            if p not in stable_set:
                children = succs.get(p, [])
                has_in = any(q in stable_set for q in children)
                has_out = any(q not in stable_set for q in children)
                
                if has_in and has_out:
                    next_j_start_set.add(p)
                    added_vertical = True
        
        if not added_vertical:
            break

        W.append([next_j_start_set])
        j += 1
        
    return W

def get_rank(p, W):
    for j in range(len(W)):
        for i in range(len(W[j])):
            if p in W[j][i]:
                return (j, i)
    return (np.inf, np.inf)

def get_successors(node, e):
    return [end for start, act, end in e if start == node]

def get_predecessors(node, e):
    return [start for start, act, end in e if end == node]

def get_transition_action(start_node, end_node, e):
    for s, act, end in e:
        if s == start_node and end == end_node:
            return act
    return None


def atteignabilite(tp0,depart,Vr,Vb,e): 
    etat_actuel=tp0
    chemin=[etat_actuel]
    while etat_actuel != depart:
        W=strategie_gagnante(etat_actuel,Vr,Vb,e)
        rank=[]
        if etat_actuel in Vr:
            mini= (np.inf,np.inf)
            for p in get_predecessors(etat_actuel,e):
                i,j=get_rank(p,W)
                if (i,j)<mini:
                    mini=(i,j)
                    etat_precedent=p
            etat_actuel=etat_precedent
        else:
            predecessors=get_predecessors(etat_actuel,e)
            etat_actuel=random.choice(predecessors)[0]
        chemin.append(etat_actuel)
    chemin.append(depart)
    return chemin[::-1]

def suivre_obj(tp0,objectif,Vr,Vb,e):
    etat_actuel=tp0
    for start,act,end in objectif:
        if start==etat_actuel and start in Vb:
            etat_actuel=end
        if start==etat_actuel and start in Vr:
            etat_suivant=random.choice(get_successors(etat_actuel,e))
            if etat_suivant!=end:
                return False,etat_suivant
            etat_actuel=etat_suivant
    return True

def test(tp0,objectif,Vr,Vb,e):
    atteignabilite(tp0,0,Vr,Vb,e)
    a=suivre_obj(tp0,objectif,Vr,Vb,e)
    while a[0]==False:
        atteignabilite(tp0,a[1],Vr,Vb,e)
        a=suivre_obj(tp0,objectif,Vr,Vb,e)
    atteignabilite(0,objectif[-1][-1],Vr,Vb,e)
    return True

