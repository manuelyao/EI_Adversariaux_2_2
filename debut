import numpy as np

def jeu_associe(IOSM, L):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t[0]=='!':
                a=t[1:]
                if a in L and s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puit'))
    Vb=[i for i in range(len(IOSM)) if i not in Vr]
    n=len(Vr+Vb)-1
    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                else:
                    Vb.append(n)
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    Vr.append(n)
    Vb.append('puit')
    e.append((n,'tau','puit'))
    e.append(('puit','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,Vr,Vb,e):
    W = [[]]
    kj = 0
    W[0][0]=[t]
   # current = {t}
   # while current != all_states_minus_bot :
   #     curreent = current cup what_uou_need_to_add
   #     W[i][j] = *current 
    i,j=0,0
    while set(W[i][j]) != set(Vr[:(len(Vr)-1)]+Vb[:(len(Vb)-1)]):
        i=1
        while W[i-1][j] != W[i][j]:
            W[i].append([])
            if i == len(W)-1:
                W.append([])
            W[i+1][j]=W[i][j]
            for p in Vb:
                if not p in W[i][j]:
                    for q in W[i][j]:
                        if (p,_,q) in e:
                            W[i+1][j].append(p)
                            break
            for p in Vr:
                if not p in W[i][j]:
                    for q in Vb:
                        if (p,_,q) in e and q in W[i][j]:
                            W[i+1][j].append(p)
                            break
            i += 1
        
        kj = i-1

        W[0].append(W[kj][j])
        for p in Vr:
            for q in Vb:
                for r in Vb:
                    if ((p,_,q) in e and (p,_,r) in e
                        and q in W[kj][j] and not r in W[kj][j]
                        and p not in W[0][j+1]):
                        W[0][j+1].append(p)
                        break
    
    return W
        
def rank(p,Vr,Vb,e):
    W = strategie_gagnante(p,Vr,Vb,e)
    for i in range(len(W)):
        for j in range(len(W[i])):
            if p in W[i][j]:
                return (i,j)
    return (np.inf,np.inf)



                
                

