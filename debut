import numpy as np
import random
import sys
import datetime
import os

def jeu_associe(IOSM):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t.startswith('!'):
                if s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puits'))

    Vb=[i for i in range(len(IOSM)) if i not in Vr]
    n=len(IOSM)

    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                    e.append((n, 'tau', 'puits'))
                else:
                    Vb.append(n)
                
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    
    Vr.append(n)
    if 'puits' not in Vb: 
        Vb.append('puits')
    e.append((n,'tau','puits'))
    e.append(('puits','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,Vr,Vb,e):
    """state, point list, point list, 3-uple list -> set list list
    Returns the W strategy matrix representing the best strategies
    when it comes to reaching t. Also allows for the calculation of
    the rank of a point."""
    
    all_nodes = Vr + Vb + ['puits']
    succs = {node: [] for node in all_nodes}
    for u, _, v in e:
        if u in succs: 
            succs[u].append(v)
    
    W = []
    current_set = {t, 'puits'}
    W.append([current_set])
    
    j = 0
    while True:
        while True:
            last_set = W[j][-1]
            new_set = last_set.copy()

            for p in Vb:
                if p not in new_set:
                    if any(q in last_set for q in succs.get(p, [])):
                        new_set.add(p)
            
            for p in Vr:
                if p not in new_set:
                    children = succs.get(p, [])
                    if children and all(q in last_set for q in children):
                        new_set.add(p)
            
            if len(new_set) == len(last_set):
                break 
            
            W[j].append(new_set)
            
        stable_set = W[j][-1]
        next_j_start_set = stable_set.copy()
        added_vertical = False
        
        for p in Vr:
            if p not in stable_set:
                children = succs.get(p, [])
                has_in = any(q in stable_set for q in children)
                has_out = any(q not in stable_set for q in children)
                
                if has_in and has_out:
                    next_j_start_set.add(p)
                    added_vertical = True
        
        if not added_vertical:
            break

        W.append([next_j_start_set])
        j += 1
        
    return W

def get_rank(p, W):
    for j in range(len(W)):
        for i in range(len(W[j])):
            if p in W[j][i]:
                return (j, i)
    return (np.inf, np.inf)

def get_successors(node, e):
    return [end for start, act, end in e if start == node]

def get_predecessors(node, e):
    return [start for start, act, end in e if end == node]

def get_transition_action(start_node, end_node, e):
    for s, act, end in e:
        if s == start_node and end == end_node:
            return act
    return None



class ConformanceTester:
    def __init__(self, Vr, Vb, e, s0, io_controller):
        self.Vr = Vr  
        self.Vb = Vb  
        self.e = e    
        self.s0 = s0 # System initial state
        self.current_state = s0
        self.io = io_controller 

    def play_reachability(self, target_node):
        """
        Executes the Reachability Game.
        Goal: Drive the system from self.current_state to target_node.
        Strategy: Use the computed Winning Strategy (W) to always pick the move 
        that minimizes the 'Rank' (distance/cost) to the target.
        """
        print(f"--- Starting Reachability Game, Target: {target_node} ---")
        
        W = strategie_gagnante(target_node, self.Vr, self.Vb, self.e)
        
        while self.current_state != target_node:
            # Check the rank of the current state
            current_rank = get_rank(self.current_state, W)
            
            # If Rank is infinite, the target is topologically unreachable from here.
            if current_rank == (np.inf, np.inf):
                print(f"Error: Target state {target_node} unreachable from {self.current_state}.")
                return False

            # === Blue State: Tester's Turn (Input) ===
            if self.current_state in self.Vb:
                succs = get_successors(self.current_state, self.e)
                best_next = None
                best_rank = (np.inf, np.inf)
                
                # Strategy: Choose the successor with the lowest Rank (lexicographical comparison)
                for next_node in succs:
                    r = get_rank(next_node, W)
                    # Lexicographical comparison: (j, i) tuple comparison works natively in Python
                    if r < best_rank:
                        best_rank = r
                        best_next = next_node
                
                if best_next is None:
                    print("Error: No move possible (Deadlock in Tester state).")
                    return False

                action = get_transition_action(self.current_state, best_next, self.e)
                
                # Send Input to the System (if it's not an internal 'tau' move)
                if action and action != 'tau':
                    self.io.write_output(action)
                    print(f"Tester sends: {action}")
                
                self.current_state = best_next

            # === Red State: System's Turn (Output) ===
            elif self.current_state in self.Vr:
                succs = get_successors(self.current_state, self.e)
                # Check if this state produces observable outputs or just internal transitions tau
                
                real_outputs = [act for s, act, end in self.e if s == self.current_state and act != 'tau']
                
                # Case A: Internal Transitions (Tau) only
                if not real_outputs:
                    best_next = succs[0]
                    best_rank = get_rank(best_next, W)
                    
                    for s_next in succs:
                        # If currently pointing to 'puits' but a valid node exists, switch.
                        if best_next == 'puits' and s_next != 'puits':
                            best_next = s_next
                            best_rank = get_rank(s_next, W)
                        # Otherwise, standard Rank minimization
                        elif s_next != 'puits':
                            r = get_rank(s_next, W)
                            if r < best_rank:
                                best_next = s_next
                                best_rank = r
                    
                    self.current_state = best_next
                
                # Case B: Observable Outputs
                else:
                    obs = self.io.get_input(self.current_state).strip() 
                    print(f"System responds: {obs}")
                    
                    # Match the observation with the model's transitions
                    found = False
                    for next_node in succs:
                        act = get_transition_action(self.current_state, next_node, self.e)
                        if act == obs:
                            self.current_state = next_node
                            found = True
                            break
                    
                    # If the observation is not allowed in the model -> Fail
                    if not found:
                        print(f"Non-conformance: Received undefined message '{obs}'!")
                        self.current_state = 'puits'
                        return False

            # Check if we fell into the sink state
            if self.current_state == 'puits':
                print("System entered non-conformance state - puits. Test ended.")
                return False
                
        print(f"Successfully reached target: {self.current_state}")
        return True

    def execute_test_purpose(self, tp_path):
        #Conformance Testing.
        tp_root = tp_path[0]
        
        # === Phase 1: Preamble ===
        # Ensure the system is at the starting node of the Test Purpose
        print("\n=== Phase 1: Preamble ===")
        if self.current_state != tp_root:
            success = self.play_reachability(tp_root)
            if not success: return "FAIL_PREAMBLE"
            
        # === Phase 2: Body ===
        # Traverse the path defined by the Test Purpose
        print("\n=== Phase 2: Body ===")
        tp_index = 0
        while tp_index < len(tp_path) - 1:
            current_tp_node = tp_path[tp_index]
            next_tp_node = tp_path[tp_index + 1]
            
            # 1. Deviation Check
            # Ensure we are still on the path required by the TP.
            if self.current_state != current_tp_node:
                print("Deviated from Test Purpose path, re-executing Preamble...")
                success = self.play_reachability(tp_root)
                if not success: return "FAIL_RECOVERY"
                tp_index = 0 # Restart TP execution
                continue

            action = get_transition_action(current_tp_node, next_tp_node, self.e)
            
            # Case A: Tester sends stimulus (Blue Node)
            if current_tp_node in self.Vb:
                if action and action != 'tau':
                    print(f"[TP] Tester sends: {action}")
                self.current_state = next_tp_node
                tp_index += 1
                
            # Case B: Tester waits for response (Red Node)
            elif current_tp_node in self.Vr:
                real_outputs = [act for s, act, end in self.e if s == current_tp_node and act != 'tau']
                
                # Silent transition (Tau)
                if not real_outputs:
                    self.current_state = next_tp_node
                    tp_index += 1
                else:
                # Observable transition
                    obs = self.io.get_input(self.current_state).strip()
                    print(f"[TP] System responds: {obs}")
                    
                    if obs == action:
                        # Expected response received -> Proceed
                        self.current_state = next_tp_node
                        tp_index += 1
                    else:
                        # The received output matches a valid transition in the model, 
                        # but NOT the one expected by the Test Purpose.
                        succs = get_successors(self.current_state, self.e)
                        found_next = None
                        for s in succs:
                            if get_transition_action(self.current_state, s, self.e) == obs:
                                found_next = s
                                break
                        
                        # Check if found_next is not None
                        if found_next is not None:
                            print(f"System valid deviation from TP (received {obs}), attempting recovery...")
                            self.current_state = found_next
                        else:
                            # Observation is not in the model at all
                            print("Non-conformance: Critical error!")
                            return "FAIL"

        print("Test Purpose Achieved!")

        # === Phase 3: Postamble ===
        # Return the system to the initial state (s0)
        print("\n=== Phase 3: Postamble ===")
        success = self.play_reachability(self.s0)
        if not success: return "FAIL_POSTAMBLE"
        
        return "PASS"


class MockIOController(object):
    def __init__(self, io_model = None):
        self.terminal = sys.stdout
        self.responses = ["!Good", "!Can"]
        self.io = io_model
        self.response_idx = 0
        self.terminal = sys.stdout
        current_time = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
        self.log = open("boisson_%s.log" % current_time, "a")

    def write_output(self, message):
        if not message.endswith(os.linesep):
            message += os.linesep
        self.terminal.write(message)
        self.log.write(message)
        self.log.flush() 

    def get_input(self, current_state):
        transitions = self.io[current_state]
        possible_outputs = [act for act, next_s in transitions if act.startswith('!')]
        if possible_outputs:
            resp = random.choice(possible_outputs)
        else:
            resp = "!Unknown"
        return resp

