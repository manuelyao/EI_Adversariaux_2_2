import numpy as np

def jeu_associe(IOSM, L):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t[0]=='!':
                a=t[1:]
                if a in L and s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puit'))
    Vb=[i for i in range(len(IOSM)) if i not in Vr]
    n=len(Vr+Vb)-1
    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                else:
                    Vb.append(n)
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    Vr.append(n)
    Vb.append('puit')
    e.append((n,'tau','puit'))
    e.append(('puit','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,Vr,Vb,e):
    """state, point list, point list, 3-uple list -> set list list
    Returns the W strategy matrix representing the best strategies
    when it comes to reaching t. Also allows for the calculation of
    the rank of a point."""
    W = [[]]
    kj = 0
    W[0][0]=[t]
    i,j=0,0
    while set(W[i][j]) != set(Vr[:(len(Vr)-1)]+Vb[:(len(Vb)-1)]): #detection of stagnance
        i=1
        while W[i-1][j] != W[i][j]:
            W[i].append([]) #dynamically grow w on axis 1
            if i == len(W)-1:
                W.append([]) #dynamically grow w on axis 0
            W[i+1][j]=W[i][j].copy()
            trouve = False
            for p in Vb:
                if not p in W[i][j]:
                    for q in W[i][j]:
                        if trouve:
                            break
                        for elt in e:
                            (pe,_,qe) = elt
                            if (p,q) == (pe,qe) and not p in W[i+1][j]:
                                W[i+1][j].append(p) #According to the formula, add all p of Vb
                                Trouve = True       #such that there exists q in Wij
                                break               #with (p,q) in e
            trouve = False
            for p in Vr:
                if not p in W[i][j]:
                    for q in Vb:
                        if trouve:
                            break
                        for elt in e:
                            (pe,_,qe) = elt         
                            if ((p,q) == (pe,qe) and q in W[i][j]
                                and not p in W[i+1][j]): 
                                                    #According to the formula, add all p of Vr
                                                    #such that there exists q
                                W[i+1][j].append(p) #in Vb with (p,q) in e and q in Wij
                                trouve = True
                                break
            i += 1
        
        kj = i-1

        W[0].append(W[kj][j].copy())
        for p in Vr:
            for q in Vb:                        #According to the formula, add all p of Vr
                for r in Vb:                    #such that there exists (q,r) in Vb² with
                    if ((p,_,q) in e and (p,_,r) in e #(p,q) and (p,r) in e, q in Wkj_j 
                        and q in W[kj][j] and not r in W[kj][j] #and r not in Wkj_j
                        and p not in W[0][j+1]):
                        W[0][j+1].append(p)
                        break
    
    return W


        
def rank(p,t,Vr,Vb,e):
    W = strategie_gagnante(t,Vr,Vb,e)
    for i in range(len(W)):
        for j in range(len(W[i])):
            if p in W[i][j]:
                return (i,j)
    return (np.inf,np.inf)



                
                

