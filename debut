if __name__ == "__main__":
    # 1. 定义简单的饮料机 IOSM 模型
    # s0: 初始, s1: 投币后, s2: 选水后, s3: 结束
    # 动作: ?Coin (Input), !Good (Output), ?Soda (Input), !Can (Output)
    # 注意：为了简化演示，省略了部分中间状态
    # 格式: [ [(动作, 目标状态), ...], ... ]
    
    # 状态 0 (初始): 接受 ?Coin -> 去状态 1
    # 状态 1 (等待结果): 系统发出 !Good -> 去状态 2
    # 状态 2 (已投币): 接受 ?Soda -> 去状态 3
    # 状态 3 (出货中): 系统发出 !Can -> 去状态 0
    iosm_model = [
        [('?Coin', 1)],       # s0
        [('!Good', 2)],       # s1 (Red Node)
        [('?Soda', 3)],       # s2
        [('!Can', 0)]         # s3 (Red Node)
    ]
    
    L = ['?Coin', '?Soda'] # 所有的输入动作
    
    print(">>> 1. 构建博弈图...")
    Vr, Vb, e = jeu_associe(iosm_model, L)
    print(f"红色节点 (System): {Vr}")
    print(f"蓝色节点 (Tester): {Vb}")
    print(f"边数: {len(e)}")
    
    print("\n>>> 2. 初始化模拟器...")
    # 我们创建一个模拟器，它会依次回复 !Good 和 !Can
    # 注意：这里的 MockController 需要配合上面的 iosm_model 逻辑
    mock_io = MockIOController()
    mock_io.responses = ["!Good", "!Can"] # 设置剧本
    
    tester = ConformanceTester(Vr, Vb, e, s0=0, io_controller=mock_io)
    
    # 定义测试目标路径: s0 -> s1 -> s2 -> s3 -> s0
    # 注意：经过 jeu_associe 转化后，红色节点 s1 和 s3 可能会产生中间节点
    # 为了简化，我们只测试到达 s2 (即投币成功状态)
    
    # 经过转化的图节点编号可能发生变化（插入了中间节点），
    # 但原始节点 0, 1, 2, 3 依然存在。
    # 让我们测试路径：0 -> ... -> 2 (投币成功)
    test_path = [0, 1, 2] 
    
    print("\n>>> 3. 执行测试目标: 投币流程 (s0 -> s1 -> s2)...")
    result = tester.execute_test_purpose(test_path)
    
    print(f"\n>>> 最终结果: {result}")