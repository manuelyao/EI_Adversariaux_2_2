    for j_prime in range(1,j+1):
        i_prime=kj
        while (i_prime<1 or W[i_prime-1][j_prime]==W[i_prime][j_prime]) and i_prime<=i:
            W[i_prime+1][j_prime]=W[i_prime][j_prime]
            for p in Vb:
                if not p in W[i_prime][j_prime]:
                    for q in W[i_prime][j_prime]:
