import numpy as np
import random

def jeu_associe(IOSM, L):   #IOSM=[[(transition,arrivee)...]]
    Vr=[]
    e=[]
    for s in range(len(IOSM)):
        for (t,s_prime) in IOSM[s]:
            if t.startswith('!'):
                a=t[1:]
                if a in L and s not in Vr:
                    Vr.append(s)
                    e.append((s,'tau','puit'))

    Vb=[i for i in range(len(IOSM)) if i not in Vr]
    n=len(Vr+Vb)-1

    for s in range(len(IOSM)):
        for t,s_prime in IOSM[s]:
            if (s in Vb and s_prime in Vr) or (s in Vr and s_prime in Vb):
                e.append((s,t,s_prime))
            else:
                if s in Vb:
                    Vr.append(n)
                    e.append((n, 'tau', 'puit'))
                else:
                    Vb.append(n)
                
                e.append((s,t,n))
                e.append((n,'tau',s_prime))
                n+=1
    
    Vr.append(n)
    if 'puit' not in Vb: Vb.append('puit')
    e.append((n,'tau','puit'))
    e.append(('puit','tau',n))
    
    return (Vr,Vb,e)



def strategie_gagnante(t,Vr,Vb,e):
    """state, point list, point list, 3-uple list -> set list list
    Returns the W strategy matrix representing the best strategies
    when it comes to reaching t. Also allows for the calculation of
    the rank of a point."""
    
    all_nodes = Vr + Vb + ['puit']
    succs = {node: [] for node in all_nodes}
    for u, _, v in e:
        if u in succs: 
            succs[u].append(v)
    
    W = []
    current_set = {t, 'puit'}
    W.append([current_set])
    
    j = 0
    while True:

        while True:
            last_set = W[j][-1]
            new_set = last_set.copy()

            for p in Vb:
                if p not in new_set:
                    if any(q in last_set for q in succs.get(p, [])):
                        new_set.add(p)
            
            for p in Vr:
                if p not in new_set:
                    children = succs.get(p, [])
                    if children and all(q in last_set for q in children):
                        new_set.add(p)
            
            if len(new_set) == len(last_set):
                break 
            
            W[j].append(new_set)
            
        stable_set = W[j][-1]
        next_j_start_set = stable_set.copy()
        added_vertical = False
        
        for p in Vr:
            if p not in stable_set:
                children = succs.get(p, [])
                has_in = any(q in stable_set for q in children)
                has_out = any(q not in stable_set for q in children)
                
                if has_in and has_out:
                    next_j_start_set.add(p)
                    added_vertical = True
        
        if not added_vertical:
            break

        W.append([next_j_start_set])
        j += 1
        
    return W

        
def rank(p,t,Vr,Vb,e):
    W = strategie_gagnante(t,Vr,Vb,e)
    for i in range(len(W)):
        for j in range(len(W[i])):
            if p in W[i][j]:
                return (i,j)
    return (np.inf,np.inf)


def get_successors(node, e):
    return [end for start, act, end in e if start == node]

def get_transition_action(start_node, end_node, e):
    for s, act, end in e:
        if s == start_node and end == end_node:
            return act
    return None
               

class ConformanceTester:
    def __init__(self, Vr, Vb, e, s0, io_controller):
        self.Vr = Vr
        self.Vb = Vb
        self.e = e
        self.s0 = s0 # System initial state
        self.current_state = s0
        self.io = io_controller

    def play_reachability(self, target_node):
        """
        Execute reachability game: Drive the system to target_node using the Rank strategy.
        """
        print(f"--- Starting Reachability Game, Target: {target_node} ---")
        
        # 1. Calculate the Rank for the entire graph regarding this target
        W = strategie_gagnante(target_node, self.Vr, self.Vb, self.e)
        
        while self.current_state != target_node:
            current_rank = rank(self.current_state, W)
            
            # If unreachable (Rank is infinite), cannot guide
            if current_rank == (float('inf'), float('inf')):
                print("Error: Target state unreachable, strategy failed.")
                return False

            if self.current_state in self.Vb:
                # --- Blue Turn (Tester) ---
                # [cite_start]Strategy: Choose the successor that decreases the Rank [cite: 544]
                succs = get_successors(self.current_state, self.e)
                best_move = None
                best_rank = (float('inf'), float('inf'))
                
                for next_node in succs:
                    r = rank(next_node, W)
                    # Lexicographical comparison: Compare j first, then i
                    if r < best_rank:
                        best_rank = r
                        best_move = next_node
                
                # Execute action
                action = get_transition_action(self.current_state, best_move, self.e)
                if action and action != 'tau':
                    self.io.write_output(action) # Send !Input
                    print(f"Tester sends: {action}")
                
                self.current_state = best_move

            elif self.current_state in self.Vr:
                # --- Red Turn (System) ---
                # Wait for system response
                # Note: If it's a tau transition, jump logically; if it's a real output, read IO
                succs = get_successors(self.current_state, self.e)
                
                # Simplified handling: Check if there are non-tau real output edges
                real_outputs = [act for s, act, end in self.e if s == self.current_state and act != 'tau']
                
                if not real_outputs:
                    # Only tau transitions (internal logic), jump directly in the model
                    # In reality there might be multiple taus, here we simply take the first one (assuming fairness)
                    self.current_state = succs[0]
                else:
                    # Wait for actual I/O
                    obs = self.io.get_input().strip() # Read ?Output
                    print(f"System responds: {obs}")
                    
                    # Find the corresponding node among successors
                    found = False
                    for next_node in succs:
                        act = get_transition_action(self.current_state, next_node, self.e)
                        if act == obs:
                            self.current_state = next_node
                            found = True
                            break
                    
                    if not found:
                        # Received undefined message -> sink (puit)
                        print("Non-conformance: Received undefined message!")
                        self.current_state = 'puit'
                        return False # Bug found, but strictly speaking ended from reachability perspective

            if self.current_state == 'puit':
                print("System entered non-conformance state (Puit). Test ended.")
                return False
                
        print(f"Successfully reached target: {self.current_state}")
        return True

    def execute_test_purpose(self, tp_path):
        """
        Main logic for Conformance Game
        tp_path: Test purpose path, i.e., a series of nodes [tp0, tp1, tp2 ...]
        """
        tp_root = tp_path[0]
        
        # 1. Preamble
        # Use reachability game to reach the starting point of the TP
        print("\n=== Phase 1: Preamble ===")
        if self.current_state != tp_root:
            success = self.play_reachability(tp_root)
            if not success: return "FAIL_PREAMBLE"
            
        # 2. Body
        # Follow the TP step by step
        print("\n=== Phase 2: Body ===")
        tp_index = 0
        while tp_index < len(tp_path) - 1:
            current_tp_node = tp_path[tp_index]
            next_tp_node = tp_path[tp_index + 1]
            
            # At this point self.current_state should equal current_tp_node
            # But if previous steps had tau transitions, synchronization might be needed
            
            # Check if deviated from TP
            if self.current_state != current_tp_node:
                print("Deviated from Test Purpose path, re-executing Preamble...")
                # Return to Preamble and retry entering TP
                success = self.play_reachability(tp_root)
                if not success: return "FAIL_RECOVERY"
                tp_index = 0 # Reset progress
                continue

            # Decide next action
            action = get_transition_action(current_tp_node, next_tp_node, self.e)
            
            if current_tp_node in self.Vb:
                # Tester actively executes the TP action
                if action and action != 'tau':
                    self.io.write_output(action)
                    print(f"[TP] Tester sends: {action}")
                self.current_state = next_tp_node
                tp_index += 1
                
            elif current_tp_node in self.Vr:
                # Wait for system response
                real_outputs = [act for s, act, end in self.e if s == current_tp_node and act != 'tau']
                if not real_outputs:
                    self.current_state = next_tp_node
                    tp_index += 1
                else:
                    obs = self.io.get_input().strip()
                    print(f"[TP] System responds: {obs}")
                    
                    # Check if the response matches the TP
                    if obs == action:
                        self.current_state = next_tp_node
                        tp_index += 1
                    else:
                        # System gave a valid but non-TP response -> Deviation
                        # Need to find the actual destination node in the full graph
                        succs = get_successors(self.current_state, self.e)
                        found_next = None
                        for s in succs:
                            if get_transition_action(self.current_state, s, self.e) == obs:
                                found_next = s
                                break
                        
                        if found_next:
                            print(f"System valid deviation from TP (received {obs}), attempting recovery...")
                            self.current_state = found_next
                            # Next loop iteration will detect state != tp_node, triggering Preamble retry
                        else:
                            print("Non-conformance: Critical error!")
                            return "FAIL"

        print("Test Purpose Achieved!")

        # 3. Postamble
        # Return to initial state s0
        print("\n=== Phase 3: Postamble ===")
        self.play_reachability(self.s0)
        
        return "PASS"
    
class MockIOController:
    """模拟 IO 控制器：自动扮演系统（饮料机）的角色"""
    def __init__(self):
        # 预设系统的行为脚本
        # 这里模拟一个不稳定的饮料机：有时给 Good，有时给 Bad
        self.responses = [
            "!Good",   # 第一次投币成功
            "!Joined", # 模拟 Platoon 或其他响应
        ]
        self.response_idx = 0

    def write_output(self, message):
        print(f"[Tester -> System] {message}")

    def get_input(self):
        # 简单模拟：根据调用次数返回预设响应
        # 实际饮料机逻辑：收到 ?Coin -> !Good / !Bad
        if self.response_idx < len(self.responses):
            resp = self.responses[self.response_idx]
            self.response_idx += 1
        else:
            resp = "!Unknown" # 模拟意外情况
            
        print(f"[System -> Tester] {resp}")
        return resp

